pid /tmp/nginx.pid;
error_log /dev/null crit;
events { worker_connections 128; }
http {
  access_log off;
  server_tokens off;
  client_body_temp_path /tmp/body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  client_max_body_size 16k;
  client_body_timeout 10s;
  client_header_timeout 10s;
  send_timeout 25s;
  keepalive_timeout 10s;
  server { listen 8080 default_server; server_name _; return 444; }
  server {
    listen 8080;
    server_name @@API_HOST@@;
    location ^~ /.well-known/acme-challenge/ {
      root /var/www/acme;
      default_type text/plain;
      limit_except GET HEAD { deny all; }
      try_files $uri =404;
    }
    location / { return 308 https://@@API_HOST@@/; }
  }
  @@TLS_DEFAULT@@
  server {
    listen @@TLS_LISTEN@@;
    server_name @@API_HOST@@;
    ssl_certificate /tls/current/fullchain.pem;
    ssl_certificate_key /tls/current/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    @@SNI_GUARD@@
    if ($http_host != '@@API_HOST@@') { return 444; }
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    location / {
      proxy_pass http://api:8000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header Connection '';
      proxy_set_header X-Forwarded-For '';
      proxy_set_header X-Forwarded-Host '';
      proxy_set_header X-Forwarded-Proto '';
      proxy_set_header X-Real-IP '';
      proxy_set_header Forwarded '';
      proxy_connect_timeout 3s;
      proxy_read_timeout 25s;
      proxy_buffering off;
    }
  }
}
