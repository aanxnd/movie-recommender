{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": { "api/gateway.mjs": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/gateway?__movelle_route=/:path*" }],
  "headers": [{ "source": "/(.*)", "headers": [
    { "key": "Cache-Control", "value": "no-store" },
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
    { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://jsbulnrcxtvslvvxjizq.supabase.co; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
  ] }]
}
